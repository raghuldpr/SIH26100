# ==============================================================================
# SIH-26100 GeM Procurement Bid Compliance Platform
# Master Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' in local development or configure in your deployment environment.
# DO NOT COMMIT PRODUCTION SECRETS TO SOURCE CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PUBLIC FRONTEND RUNTIME (Vite / React)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_API_URL=http://localhost:8000/api/v1

# ------------------------------------------------------------------------------
# 2. FASTAPI BACKEND SERVER
# ------------------------------------------------------------------------------
APP_NAME=SIH26100
APP_ENV=production
PROJECT_DESCRIPTION="AI-powered Bid Compliance Verification Platform for GeM procurement"
VERSION=0.1.0
API_V1_STR=/api/v1

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Allowed CORS origins (comma-separated list, or '*' for unrestricted internal staging)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 3. JWT AUTHENTICATION
# ------------------------------------------------------------------------------
# Generate a cryptographically strong 256-bit secret key in production: openssl rand -hex 32
JWT_SECRET_KEY=change-this-to-a-secure-random-256-bit-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ------------------------------------------------------------------------------
# 4. DATABASE CONFIGURATION (PostgreSQL / Supabase)
# ------------------------------------------------------------------------------
# Example: postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sih26100_db

# Database Connection Pooling
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ------------------------------------------------------------------------------
# 5. STORAGE & DOCUMENT VAULT
# ------------------------------------------------------------------------------
STORAGE_PATH=./storage
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
SUPABASE_STORAGE_BUCKET=documents
MAX_UPLOAD_SIZE_MB=25
MAX_UPLOAD_FILES_PER_REQUEST=10

# ------------------------------------------------------------------------------
# 6. DOCUMENT ENGINE MICROSERVICE (OCR & Deterministic Extraction)
# ------------------------------------------------------------------------------
DOCUMENT_ENGINE_URL=http://localhost:8001
DOCUMENT_ENGINE_PORT=8001
DOCUMENT_ENGINE_TIMEOUT_SECONDS=60.0

# ------------------------------------------------------------------------------
# 7. AI GATEWAY (Groq Server-Side LLaMA-3.3 Fallback Only)
# ------------------------------------------------------------------------------
# Groq API key is accessed exclusively server-side by backend/app/services/ai_gateway.py
GROQ_API_KEY=gsk_your_actual_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=30.0
GROQ_MAX_RETRIES=2
GROQ_TEMPERATURE=0.0

# ------------------------------------------------------------------------------
# 8. n8n MULTI-AGENT ORCHESTRATION LAYER
# ------------------------------------------------------------------------------
N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_URL=http://localhost:5678/webhook/sih26100/bid-verification
N8N_API_KEY=
N8N_WEBHOOK_SECRET=sih26100-n8n-webhook-secret-token
N8N_TIMEOUT_SECONDS=60.0
N8N_MAX_RETRIES=3
