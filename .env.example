APP_NAME=SIH26100
APP_ENV=development
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
STORAGE_PATH=./storage

# Supabase Storage Configuration
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=documents
MAX_UPLOAD_SIZE_MB=10

# Groq AI Gateway Configuration (Phase 08 - Ambiguous Clause Escalation Only)
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# n8n Multi-Agent Orchestration Configuration (Phase 10)
N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_URL=http://localhost:5678/webhook/sih26100/bid-verification
N8N_API_KEY=your-n8n-api-key-if-configured
N8N_WEBHOOK_SECRET=sih26100-n8n-webhook-secret
N8N_TIMEOUT_SECONDS=60.0
N8N_MAX_RETRIES=3
