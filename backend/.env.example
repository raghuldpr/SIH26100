# ==============================================================================
# SIH-26100 FastAPI Backend Environment Example
# ==============================================================================

APP_NAME=SIH26100
APP_ENV=production
PROJECT_DESCRIPTION="AI-powered Bid Compliance Verification Platform for GeM procurement"
VERSION=0.1.0
API_V1_STR=/api/v1

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
LOG_LEVEL=INFO

# Authentication
JWT_SECRET_KEY=change-this-to-a-secure-random-256-bit-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sih26100_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Storage
STORAGE_PATH=./storage
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
SUPABASE_STORAGE_BUCKET=documents
MAX_UPLOAD_SIZE_MB=25
MAX_UPLOAD_FILES_PER_REQUEST=10

# AI Gateway (Groq)
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=30.0
GROQ_MAX_RETRIES=2
GROQ_TEMPERATURE=0.0

# n8n Verification Orchestration
N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_URL=http://localhost:5678/webhook/sih26100/bid-verification
N8N_API_KEY=
N8N_WEBHOOK_SECRET=sih26100-n8n-webhook-secret
N8N_TIMEOUT_SECONDS=60.0
N8N_MAX_RETRIES=3
